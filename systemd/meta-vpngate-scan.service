[Unit]
Description=Benchmark US VPN Gate nodes and select a stable Meta exit
After=network-online.target meta-vpngate-health.service
Wants=network-online.target
[Service]
EnvironmentFile=-/etc/meta-vpngate/settings.env
Type=oneshot
ExecStart=/usr/local/libexec/meta-vpngate-scan.py
TimeoutStartSec=35min
UMask=0077
StateDirectory=meta-vpngate
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
