[Unit]
Description=Warm US VPN Gate standby %i
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/meta-vpngate/standby-%i.ovpn
[Service]
Type=simple
ExecStart=/usr/sbin/openvpn --config /etc/meta-vpngate/standby-%i.ovpn
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
